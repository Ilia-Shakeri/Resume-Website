{
  "name": "ilia-shakeri-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal DevOps engineering portfolio of Ilia Shakeri.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve@14 out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "resume:pdf": "node scripts/build-resume-pdf.mjs",
    "qa:screens": "node scripts/qa-screenshots.mjs",
    "og:image": "node scripts/build-og-image.mjs",
    "assets": "npm run build && npm run resume:pdf && npm run og:image && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.35.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "playwright-core": "1.56.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
