{
  "name": "ilia-shakeri-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal DevOps engineering portfolio of Ilia Shakeri.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-site.mjs",
    "start": "node scripts/static-server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "resume:pdf": "node scripts/build-resume-pdf.mjs",
    "qa:screens": "node scripts/qa-screenshots.mjs && node scripts/qa-reveal.mjs",
    "og:image": "node scripts/build-og-image.mjs",
    "assets": "npm run build && node scripts/sync-assets.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:live": "node scripts/smoke-live.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "next": "^16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "simple-icons": "16.35.0"
  },
  "devDependencies": {
    "@sparticuz/chromium": "141.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "^4.10.3",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.5",
    "pdfjs-dist": "5.4.296",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
